# Database
DATABASE_URL=postgresql://sippe_user:STRONG_PASSWORD@localhost:5432/sippe_db

# JWT
JWT_SECRET=           # generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=   # different secret, also 64 random bytes
JWT_REFRESH_EXPIRY=7d

# App
